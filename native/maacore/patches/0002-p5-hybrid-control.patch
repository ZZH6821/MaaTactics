diff --git a/src/MaaCore/Task/Experiment/TacticalHybridTask.cpp b/src/MaaCore/Task/Experiment/TacticalHybridTask.cpp
new file mode 100644
--- /dev/null
+++ b/src/MaaCore/Task/Experiment/TacticalHybridTask.cpp
@@ -0,0 +1,487 @@
+#include "TacticalBattleTask.h"
+
+#include "Assistant.h"
+#include "Config/Miscellaneous/CopilotConfig.h"
+#include "Utils/Logger.hpp"
+#include <thread>
+#include <utility>
+
+bool asst::TacticalBattleTask::prepare_hybrid(const json::value* rehearsal)
+{
+    if (m_inst->running()) {
+        return false;
+    }
+    {
+        std::lock_guard mailbox(m_hybrid_mutex);
+        const auto state = m_hybrid_view.get("state", "idle");
+        if (state != "idle" && state != "completed" && state != "failed" && state != "cancelled") {
+            return false;
+        }
+    }
+    if (rehearsal && (m_inst->connected() || !bind_stage(rehearsal->get("stage_name", "")))) {
+        return false;
+    }
+    std::unique_lock context(m_context_mutex, std::try_to_lock);
+    if (!context.owns_lock()) {
+        return false;
+    }
+    if (rehearsal) {
+        const auto actions = CopilotConfig::parse_actions(*rehearsal);
+        const auto groups = CopilotConfig::parse_groups(*rehearsal);
+        if (!actions || !groups) {
+            return false;
+        }
+        for (const auto& action : *actions) {
+            using T = battle::copilot::ActionType;
+            if ((action.type != T::Output && action.type != T::SetUnitLocation && action.type != T::SkillUsage &&
+                 action.type != T::ResetStopwatch) ||
+                action.costs || action.cost_changes || action.kills || action.cooling > 0 || action.pre_delay ||
+                action.post_delay) {
+                return false;
+            }
+        }
+        m_combat_data.actions = *actions;
+        m_combat_data.groups = *groups;
+    }
+    std::lock_guard mailbox(m_hybrid_mutex);
+    m_hybrid_enabled = true;
+    m_rehearsal = rehearsal != nullptr;
+    m_hybrid_timer_suspended = false;
+    m_pause_requested = false;
+    m_agent_action = false;
+    m_replan_current = false;
+    m_refresh_condition_image = false;
+    m_hybrid_command = json::value();
+    m_plan_revision = 1;
+    m_checkpoint_sequence = 0;
+    m_next_action = 0;
+    m_completed_actions = 0;
+    m_strategy_ticks = 0;
+    m_skipped_actions.clear();
+    m_hybrid_view = json::object { { "ok", true },
+                                   { "state", "preparing" },
+                                   { "run_generation", ++m_run_generation },
+                                   { "plan_revision", m_plan_revision } };
+    return true;
+}
+
+json::value asst::TacticalBattleTask::hybrid_state() const
+{
+    std::lock_guard mailbox(m_hybrid_mutex);
+    return m_hybrid_view;
+}
+
+json::value asst::TacticalBattleTask::hybrid_control(const json::value& command)
+{
+    std::lock_guard mailbox(m_hybrid_mutex);
+    const auto fail = [](const char* reason) {
+        return json::object { { "ok", false }, { "error", reason } };
+    };
+    if (command.get("run_generation", uint64_t { 0 }) != m_run_generation) {
+        return fail("HYBRID_RUN_MISMATCH");
+    }
+    const auto kind = command.get("kind", "");
+    const auto state = m_hybrid_view.get("state", "idle");
+    if (kind == "pause") {
+        if (state == "paused") {
+            return json::object { { "ok", true }, { "done", true } };
+        }
+        if (state != "running" && state != "preparing" && state != "pause_requested") {
+            return fail("HYBRID_NOT_RUNNING");
+        }
+        if (!m_pause_requested) {
+            m_pause_requested = true;
+            m_pause_command_id = ++m_command_sequence;
+            m_hybrid_view["state"] = "pause_requested";
+        }
+        return json::object { { "ok", true }, { "command_id", m_pause_command_id } };
+    }
+    if (state != "paused" || !m_hybrid_command.is_null()) {
+        return fail("HYBRID_NOT_PAUSED");
+    }
+    const auto& checkpoint = m_hybrid_view.at("checkpoint");
+    if (command.get("checkpoint_id", "") != checkpoint.get("checkpoint_id", "") ||
+        command.get("plan_revision", uint64_t { 0 }) != m_plan_revision ||
+        command.get("action_sequence", uint64_t { 0 }) != m_action_sequence) {
+        return fail("CHECKPOINT_MISMATCH");
+    }
+    if (kind != "resume" && kind != "action" && kind != "revise") {
+        return fail("HYBRID_COMMAND_UNSUPPORTED");
+    }
+    m_hybrid_command = command;
+    const auto id = ++m_command_sequence;
+    m_hybrid_command["command_id"] = id;
+    m_hybrid_view["state"] = kind == "resume" ? "resuming" : "command_pending";
+    m_hybrid_cv.notify_all();
+    return json::object { { "ok", true }, { "command_id", id } };
+}
+
+void asst::TacticalBattleTask::publish_checkpoint_locked()
+{
+    auto checkpoint = context_snapshot_locked();
+    checkpoint["checkpoint_id"] = std::to_string(m_run_generation) + ":" + std::to_string(m_checkpoint_sequence);
+    checkpoint["run_generation"] = m_run_generation;
+    checkpoint["plan_revision"] = m_plan_revision;
+    checkpoint["next_action_index"] = m_next_action;
+    checkpoint["action_count"] = m_combat_data.actions.size();
+    checkpoint["completed_action_count"] = m_completed_actions;
+    checkpoint["condition"] = m_wait_state;
+    checkpoint["cost"] = m_cost;
+    checkpoint["kills"] = m_kills;
+    checkpoint["total_kills"] = m_total_kills;
+    checkpoint["strategy_ticks"] = m_strategy_ticks;
+    checkpoint["timer_suspended"] = m_hybrid_timer_suspended;
+    json::array groups, skipped, last_skill_times;
+    for (const auto& [group, oper] : m_oper_in_group) {
+        groups.emplace_back(
+            json::object { { "group", group.name }, { "name", oper.name }, { "role", static_cast<int>(oper.role) } });
+    }
+    for (auto index : m_skipped_actions) {
+        skipped.emplace_back(index);
+    }
+    for (const auto& [oper, time] : m_last_use_skill_time) {
+        last_skill_times.emplace_back(
+            json::object {
+                { "name", oper.name },
+                { "steady_clock_ms",
+                  std::chrono::duration_cast<std::chrono::milliseconds>(time.time_since_epoch()).count() } });
+    }
+    checkpoint["groups"] = std::move(groups);
+    checkpoint["skipped_indices"] = std::move(skipped);
+    checkpoint["last_skill_times"] = std::move(last_skill_times);
+    std::lock_guard mailbox(m_hybrid_mutex);
+    m_hybrid_view["checkpoint"] = std::move(checkpoint);
+    m_hybrid_view["checkpoint_valid"] = true;
+    m_hybrid_view["plan_revision"] = m_plan_revision;
+    m_hybrid_view["next_action_index"] = m_next_action;
+    m_hybrid_view["completed_action_count"] = m_completed_actions;
+}
+
+bool asst::TacticalBattleTask::hybrid_safe_point()
+{
+    if (m_agent_action || !m_hybrid_enabled) {
+        return !need_exit();
+    }
+    {
+        std::lock_guard mailbox(m_hybrid_mutex);
+        if (!m_pause_requested || m_in_bullet_time) {
+            return !need_exit();
+        }
+        m_pause_requested = false;
+        ++m_checkpoint_sequence;
+        m_hybrid_pause_started = std::chrono::steady_clock::now();
+        m_hybrid_timer_suspended = true;
+    }
+    publish_checkpoint_locked();
+    {
+        std::lock_guard mailbox(m_hybrid_mutex);
+        m_hybrid_view["state"] = "paused";
+        m_hybrid_view["last_command"] = json::object { { "id", m_pause_command_id }, { "ok", true } };
+    }
+    m_hybrid_context_lock->unlock();
+    while (!need_exit()) {
+        json::value command;
+        {
+            std::unique_lock mailbox(m_hybrid_mutex);
+            m_hybrid_cv.wait_for(mailbox, std::chrono::milliseconds(25), [&]() { return !m_hybrid_command.is_null(); });
+            if (m_hybrid_command.is_null()) {
+                continue;
+            }
+            command = std::move(m_hybrid_command);
+            m_hybrid_command = json::value();
+        }
+        m_hybrid_context_lock->lock();
+        const bool resume = process_hybrid_command(command);
+        if (!m_context_valid || need_exit()) {
+            return false;
+        }
+        if (resume) {
+            m_refresh_condition_image = true;
+            return !m_replan_current;
+        }
+        m_hybrid_context_lock->unlock();
+    }
+    m_hybrid_context_lock->lock();
+    return false;
+}
+
+bool asst::TacticalBattleTask::process_hybrid_command(const json::value& command)
+{
+    const auto kind = command.get("kind", "");
+    json::value result = json::object { { "id", command.get("command_id", uint64_t { 0 }) }, { "ok", true } };
+    bool resume = false;
+    const auto reject = [&](const char* error) {
+        result["ok"] = false;
+        result["error"] = error;
+        return false;
+    };
+    const auto apply = [&]() -> bool {
+        if (kind == "resume") {
+            if (m_stopwatch_enabled) {
+                m_stopwatch_start_time += std::chrono::steady_clock::now() - m_hybrid_pause_started;
+            }
+            m_hybrid_timer_suspended = false;
+            return true;
+        }
+        else if (kind == "revise") {
+            const auto& edits = command.at("edits").as_array();
+            if (edits.empty() || edits.size() > 256) {
+                return reject("EDITS_INVALID");
+            }
+            std::set<size_t> touched;
+            auto actions = m_combat_data.actions;
+            auto skipped = m_skipped_actions;
+            for (const auto& edit : edits) {
+                const auto index = edit.get("index", -1);
+                if (index < 0 || static_cast<size_t>(index) < m_next_action ||
+                    static_cast<size_t>(index) >= actions.size() || !touched.insert(index).second) {
+                    return reject("EDIT_RANGE_INVALID");
+                }
+                if (edit.get("op", "") == "skip") {
+                    skipped.insert(index);
+                }
+                else if (edit.get("op", "") == "replace") {
+                    const auto parsed =
+                        CopilotConfig::parse_actions(json::object { { "actions", json::array { edit.at("action") } } });
+                    if (!parsed || parsed->size() != 1) {
+                        return reject("REPLACEMENT_INVALID");
+                    }
+                    using T = battle::copilot::ActionType;
+                    const auto& action = parsed->front();
+                    if (m_rehearsal && action.type != T::Output && action.type != T::SetUnitLocation &&
+                        action.type != T::SkillUsage && action.type != T::ResetStopwatch) {
+                        return reject("REHEARSAL_INPUT_FORBIDDEN");
+                    }
+                    actions[index] = action;
+                    skipped.erase(index);
+                }
+                else {
+                    return reject("EDIT_INVALID");
+                }
+            }
+            m_combat_data.actions = std::move(actions);
+            m_skipped_actions = std::move(skipped);
+            m_replan_current = m_replan_current || touched.contains(m_next_action);
+            ++m_plan_revision;
+        }
+        else if (kind == "action") {
+            const auto parsed =
+                CopilotConfig::parse_actions(json::object { { "actions", json::array { command.at("action") } } });
+            if (!parsed || parsed->size() != 1) {
+                return reject("ACTION_INVALID");
+            }
+            const auto& action = parsed->front();
+            using T = battle::copilot::ActionType;
+            const bool memory = action.type == T::Output || action.type == T::SetUnitLocation ||
+                                action.type == T::SkillUsage || action.type == T::ResetStopwatch;
+            if ((!memory && action.type != T::Deploy && action.type != T::Retreat && action.type != T::UseSkill &&
+                 action.type != T::SwitchSpeed) ||
+                (m_rehearsal && !memory) || action.kills || action.costs || action.cost_changes ||
+                action.elapsed_time || action.cooling > 0 || action.pre_delay || action.post_delay) {
+                return reject("AGENT_ACTION_UNSUPPORTED");
+            }
+            m_agent_action = true;
+            if (action.type == T::SwitchSpeed) {
+                const int speed = command.get("absolute_speed", 0);
+                if (speed < 1 || speed > 2) {
+                    m_agent_action = false;
+                    return reject("ABSOLUTE_SPEED_REQUIRED");
+                }
+                m_in_speedup = speed == 1;
+            }
+            const auto sequence = ++m_action_sequence;
+            const bool returned = do_action(action, m_next_action) && !need_exit();
+            m_agent_action = false;
+            if (returned && action.type == T::UseSkill) {
+                const auto named = get_name_from_group(action.role, action.name);
+                for (const auto& [oper, location] : m_battlefield_opers) {
+                    if ((action.location && *action.location == location) ||
+                        (!action.location && named.name == oper.name &&
+                         (named.role == battle::Role::Unknown || named.role == oper.role))) {
+                        m_last_use_skill_time[oper] = std::chrono::steady_clock::now();
+                        m_skill_error_count[oper] = 0;
+                        auto usage = m_skill_usage.find(oper);
+                        auto times = m_skill_times.find(oper);
+                        if (usage != m_skill_usage.end() && usage->second == battle::SkillUsage::Times &&
+                            times != m_skill_times.end() && times->second > 0 && --times->second == 0) {
+                            usage->second = battle::SkillUsage::TimesUsed;
+                        }
+                        break;
+                    }
+                }
+            }
+            if (action.type == T::ResetStopwatch) {
+                m_hybrid_pause_started = m_stopwatch_start_time;
+            }
+            result["action_result"] = json::object { { "action_sequence", sequence },
+                                                     { "context_revision", m_revision.load() },
+                                                     { "engine_return", returned },
+                                                     { "reason", returned ? "OK" : "ACTION_RETURNED_FALSE" },
+                                                     { "game_effect", "unknown" } };
+            auto info = basic_info_with_what("TacticalActionCompleted");
+            info["details"] = result["action_result"];
+            info["details"]["controller"] = "agent";
+            callback(AsstMsg::SubTaskExtraInfo, info);
+            if (!returned) {
+                result["ok"] = false;
+                result["error"] = "TACTICAL_ACTION_FAILED";
+                invalidate_locked();
+            }
+        }
+        return false;
+    };
+    try {
+        resume = apply();
+    }
+    catch (const std::exception& error) {
+        if (m_agent_action) {
+            invalidate_locked();
+        }
+
+        m_agent_action = false;
+        result["ok"] = false;
+        result["error"] = "HYBRID_COMMAND_EXCEPTION";
+        result["diagnostic"] = std::string(error.what()).substr(0, 512);
+    }
+    publish_checkpoint_locked();
+    {
+        std::lock_guard mailbox(m_hybrid_mutex);
+        m_hybrid_view["state"] = !m_context_valid ? "failed" : resume ? "running" : "paused";
+        m_hybrid_view["last_command"] = std::move(result);
+    }
+    return resume;
+}
+
+bool asst::TacticalBattleTask::condition_point(const char* kind, int baseline)
+{
+    if (m_agent_action) {
+        return !need_exit();
+    }
+    m_wait_state = json::object { { "kind", kind }, { "cost_baseline", baseline } };
+    return hybrid_safe_point();
+}
+
+bool asst::TacticalBattleTask::condition_observation_invalidated()
+{
+    return std::exchange(m_refresh_condition_image, false);
+}
+
+bool asst::TacticalBattleTask::do_strategic_action(const cv::Mat& reusable)
+{
+    if (m_agent_action) {
+        return false;
+    }
+    ++m_strategy_ticks;
+    return m_rehearsal ? false : BattleHelper::do_strategic_action(reusable);
+}
+
+bool asst::TacticalBattleTask::wait_condition(const battle::copilot::Action& action)
+{
+    if (!m_rehearsal) {
+        return BattleProcessTask::wait_condition(action);
+    }
+    while (!need_exit() && m_stopwatch_enabled && elapsed_time() < action.elapsed_time) {
+        if (!condition_point("elapsed_time", 0)) {
+            return false;
+        }
+        do_strategic_action();
+        std::this_thread::sleep_for(std::chrono::milliseconds(5));
+    }
+    return condition_point("condition_satisfied", 0);
+}
+
+void asst::TacticalBattleTask::finish_hybrid(const std::string& state)
+{
+    m_hybrid_timer_suspended = false;
+    std::lock_guard mailbox(m_hybrid_mutex);
+    m_hybrid_view["state"] = state;
+    m_hybrid_view["checkpoint_valid"] = false;
+    m_hybrid_view["next_action_index"] = m_next_action;
+    m_hybrid_view["completed_action_count"] = m_completed_actions;
+    m_hybrid_view["plan_revision"] = m_plan_revision;
+    m_hybrid_view["strategy_ticks"] = m_strategy_ticks;
+    m_hybrid_context_lock = nullptr;
+}
+
+bool asst::TacticalBattleTask::run_hybrid()
+{
+    std::unique_lock context(m_context_mutex);
+    m_hybrid_context_lock = &context;
+    const auto finish = [&](const char* state, bool returned) {
+        if (!returned) {
+            invalidate_locked();
+        }
+        finish_hybrid(state);
+        return returned;
+    };
+    BattleProcessTask::clear();
+    m_context_valid = calc_tiles_info(m_stage_name);
+    if (!m_context_valid || (!m_rehearsal && !update_deployment(true))) {
+        return finish("failed", false);
+    }
+    if (m_rehearsal) {
+        m_in_battle = true;
+    }
+    to_group();
+    {
+        std::lock_guard mailbox(m_hybrid_mutex);
+        m_hybrid_view["state"] = m_pause_requested ? "pause_requested" : "running";
+    }
+    while (m_next_action < m_combat_data.actions.size() && !need_exit() && m_in_battle) {
+        m_replan_current = false;
+        if (!condition_point("action_boundary", 0)) {
+            if (m_replan_current && !need_exit()) {
+                continue;
+            }
+            return finish(need_exit() ? "cancelled" : "failed", false);
+        }
+        if (m_skipped_actions.contains(m_next_action)) {
+            ++m_next_action;
+            continue;
+        }
+        // Keep the stack action stable while its future revision is edited.
+        const auto action = m_combat_data.actions.at(m_next_action);
+        const bool returned = do_action(action, m_next_action) && !need_exit();
+        if (m_replan_current && !need_exit()) {
+            continue;
+        }
+        auto info = basic_info_with_what("HybridActionCompleted");
+        info["details"] = json::object { { "index", m_next_action },
+                                         { "action_sequence", ++m_action_sequence },
+                                         { "engine_return", returned },
+                                         { "plan_revision", m_plan_revision },
+                                         { "reason", returned ? "OK" : "ACTION_RETURNED_FALSE" },
+                                         { "context_revision", m_revision.load() },
+                                         { "controller", "copilot" },
+                                         { "game_effect", "unknown" } };
+        callback(AsstMsg::SubTaskExtraInfo, info);
+        if (!returned) {
+            return finish(need_exit() ? "cancelled" : "failed", false);
+        }
+        ++m_completed_actions;
+        ++m_next_action;
+        {
+            std::lock_guard mailbox(m_hybrid_mutex);
+            m_hybrid_view["next_action_index"] = m_next_action;
+            m_hybrid_view["completed_action_count"] = m_completed_actions;
+        }
+    }
+    return finish(need_exit() ? "cancelled" : "completed", !need_exit());
+}
+
+bool asst::TacticalBattleTask::_run()
+{
+    if (!m_hybrid_enabled) {
+        return false;
+    }
+    try {
+        return run_hybrid();
+    }
+    catch (const std::exception& error) {
+        LogError << "Hybrid execution failed" << error.what();
+        std::lock_guard context(m_context_mutex);
+        invalidate_locked();
+        finish_hybrid("failed");
+        return false;
+    }
+}
