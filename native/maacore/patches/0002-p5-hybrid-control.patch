+AsstSize AsstHybridGetState(AsstHandle handle, void* buffer, AsstSize buffer_size)
+{
+    auto* assistant = dynamic_cast<asst::Assistant*>(handle);
+    if (!assistant) {
+        return 0;
+    }
+    try {
+        return copy_battle_json(assistant->tactical_battle()->hybrid_state(), buffer, buffer_size);
+    }
+    catch (const std::exception& error) {
+        LogError << "Hybrid query failed" << error.what();
+        return 0;
+    }
+}
+
+AsstSize AsstHybridControl(AsstHandle handle, const char* command, void* buffer, AsstSize buffer_size)
+{
+    auto* assistant = dynamic_cast<asst::Assistant*>(handle);
+    if (!assistant || !command || std::strlen(command) > 65'536) {
+        return 0;
+    }
+    try {
+        const auto parsed = json::parse(command);
+        if (!parsed) {
+            return 0;
+        }
+        return copy_battle_json(assistant->tactical_battle()->hybrid_control(*parsed), buffer, buffer_size);
+    }
+    catch (const std::exception& error) {
+        LogError << "Hybrid control failed" << error.what();
+        return 0;
+    }
+}
