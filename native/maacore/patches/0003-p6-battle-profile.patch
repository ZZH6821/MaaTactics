+    list(FILTER maa_src EXCLUDE REGEX "/Task/Fight/[^/]*[.]cpp$")
+    list(APPEND maa_src
+        "${CMAKE_CURRENT_SOURCE_DIR}/Task/Fight/DrGrandetTaskPlugin.cpp"
+        "${CMAKE_CURRENT_SOURCE_DIR}/Task/Fight/MedicineCounterTaskPlugin.cpp")
+    set(battle_interfaces CopilotTask CustomTask SingleStepTask)
+    set(battle_misc BattleFormationTask BattleProcessTask MultiCopilotTaskPlugin ScreenshotTaskPlugin)
