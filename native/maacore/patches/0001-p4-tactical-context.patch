diff --git a/src/MaaCore/TacticalCaller.cpp b/src/MaaCore/TacticalCaller.cpp
new file mode 100644
--- /dev/null
+++ b/src/MaaCore/TacticalCaller.cpp
@@ -0,0 +1,69 @@
+#include "AsstCaller.h"
+
+#include <cstring>
+
+#include "Assistant.h"
+#include "Task/Experiment/TacticalBattleTask.h"
+#include "Utils/Logger.hpp"
+
+static AsstSize copy_battle_json(const json::value& value, void* buffer, AsstSize buffer_size)
+{
+    const auto text = value.to_string();
+    if (buffer && buffer_size >= text.size()) {
+        std::memcpy(buffer, text.data(), text.size());
+    }
+    return text.size();
+}
+
+uint32_t AsstBattleAbiVersion()
+{
+    return 1;
+}
+
+AsstBool AsstBattleReset(AsstHandle handle, const char* stage_name)
+{
+    auto* assistant = dynamic_cast<asst::Assistant*>(handle);
+    if (!assistant || !stage_name || assistant->running() || !assistant->get_tasks_list().empty()) {
+        return 0;
+    }
+    try {
+        return assistant->tactical_battle()->bind_stage(stage_name) ? 1 : 0;
+    }
+    catch (const std::exception& error) {
+        LogError << "Tactical context reset failed" << error.what();
+        return 0;
+    }
+}
+
+AsstSize AsstBattleGetContext(AsstHandle handle, void* buffer, AsstSize buffer_size)
+{
+    auto* assistant = dynamic_cast<asst::Assistant*>(handle);
+    if (!assistant) {
+        return 0;
+    }
+    try {
+        return copy_battle_json(assistant->tactical_battle()->context_snapshot(), buffer, buffer_size);
+    }
+    catch (const std::exception& error) {
+        LogError << "Tactical context query failed" << error.what();
+        return 0;
+    }
+}
+
+AsstSize AsstBattleObserve(AsstHandle handle, const void* png, AsstSize png_size, void* buffer, AsstSize buffer_size)
+{
+    auto* assistant = dynamic_cast<asst::Assistant*>(handle);
+    if (!assistant) {
+        return 0;
+    }
+    try {
+        return copy_battle_json(
+            assistant->tactical_battle()->observe(static_cast<const unsigned char*>(png), png_size),
+            buffer,
+            buffer_size);
+    }
+    catch (const std::exception& error) {
+        LogError << "Tactical observation failed" << error.what();
+        return 0;
+    }
+}
diff --git a/src/MaaCore/Task/Experiment/TacticalBattleTask.h b/src/MaaCore/Task/Experiment/TacticalBattleTask.h
new file mode 100644
