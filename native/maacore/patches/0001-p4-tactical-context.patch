@@ -0,0 +1,32 @@
+#pragma once
+#include "Task/Miscellaneous/BattleProcessTask.h"
+#include <atomic>
+#include <mutex>
+
+namespace asst
+{
+class TacticalBattleTask final : public BattleProcessTask
+{
+public:
+    using Actions = std::vector<battle::copilot::Action>;
+    TacticalBattleTask(const AsstCallback& callback, Assistant* inst);
+    bool bind_stage(const std::string& stage);
+    uint64_t revision() const;
+    bool execute(const Actions& actions, uint64_t expected_revision, int task_id, int absolute_speed = 0);
+    json::value context_snapshot() const;
+    json::value observe(const unsigned char* png, size_t size);
+
+protected:
+    bool _run() override { return false; }
+
+    void sleep_and_do_strategy(unsigned millisecond) override;
+
+private:
+    json::value context_snapshot_locked() const;
+    void invalidate_locked();
+    mutable std::mutex m_context_mutex;
+    std::atomic_uint64_t m_revision = 0;
+    uint64_t m_action_sequence = 0;
+    bool m_context_valid = false;
+};
+}
diff --git a/src/MaaCore/Task/Experiment/TacticalBattleTask.cpp b/src/MaaCore/Task/Experiment/TacticalBattleTask.cpp
new file mode 100644
--- /dev/null
+++ b/src/MaaCore/Task/Experiment/TacticalBattleTask.cpp
@@ -0,0 +1,281 @@
+#include "TacticalBattleTask.h"
+
+#include "MaaUtils/NoWarningCV.hpp"
+#include "Utils/Logger.hpp"
+#include "Vision/Battle/BattlefieldClassifier.h"
+#include "Vision/Battle/BattlefieldMatcher.h"
+#include "Vision/RegionOCRer.h"
+
+asst::TacticalBattleTask::TacticalBattleTask(const AsstCallback& callback, Assistant* inst) :
+    BattleProcessTask(callback, inst, "SingleStep")
+{
+}
+
+void asst::TacticalBattleTask::invalidate_locked()
+{
+    BattleProcessTask::clear();
+    m_stage_name.clear();
+    m_in_bullet_time = false;
+    m_cost = 0;
+    m_in_speedup = false;
+    m_has_multi_stages = false;
+    m_map_data = {};
+    m_context_valid = false;
+    ++m_revision;
+}
+
+void asst::TacticalBattleTask::sleep_and_do_strategy(unsigned millisecond)
+{
+    if (millisecond != 0) {
+        BattleProcessTask::sleep_and_do_strategy(millisecond);
+    }
+}
+
+bool asst::TacticalBattleTask::bind_stage(const std::string& stage)
+{
+    std::unique_lock lock(m_context_mutex, std::try_to_lock);
+    if (!lock.owns_lock()) {
+        return false;
+    }
+    if (!stage.empty() && (!Tile.find(stage) || !json::open(Tile.find(stage)->second))) {
+        LogError << "Unsupported tactical stage" << stage;
+        return false;
+    }
+    invalidate_locked();
+    if (stage.empty()) {
+        return true;
+    }
+    m_stage_name = stage;
+    m_context_valid = calc_tiles_info(stage);
+    return m_context_valid;
+}
+
+uint64_t asst::TacticalBattleTask::revision() const
+{
+    return m_revision.load();
+}
+
+bool asst::TacticalBattleTask::execute(
+    const Actions& actions,
+    uint64_t expected_revision,
+    int task_id,
+    int absolute_speed)
+{
+    std::lock_guard lock(m_context_mutex);
+    set_task_id(task_id);
+    if (!m_context_valid || expected_revision != m_revision) {
+        auto info = basic_info_with_what("TacticalActionCompleted");
+        info["details"] = json::object { { "context_revision", m_revision.load() },
+                                         { "action_sequence", ++m_action_sequence },
+                                         { "engine_return", false },
+                                         { "reason", "CONTEXT_INVALID" },
+                                         { "game_effect", "unknown" } };
+        callback(AsstMsg::SubTaskExtraInfo, info);
+        return false;
+    }
+    for (size_t index = 0; index < actions.size(); ++index) {
+        const auto sequence = ++m_action_sequence;
+        bool returned = false;
+        std::string reason = "ACTION_RETURNED_FALSE";
+        try {
+            if (!need_exit()) {
+                if (absolute_speed != 0) {
+                    m_in_speedup = absolute_speed == 1;
+                }
+                returned = do_action(actions[index], index);
+            }
+            if (need_exit()) {
+                returned = false;
+                reason = "CANCELLED";
+            }
+            else if (returned) {
+                reason = "OK";
+            }
+        }
+        catch (const std::exception& error) {
+            LogError << "Tactical action failed" << error.what();
+            reason = "ACTION_EXCEPTION";
+        }
+        auto info = basic_info_with_what("TacticalActionCompleted");
+        info["details"] = json::object { { "context_revision", m_revision.load() },
+                                         { "action_sequence", sequence },
+                                         { "batch_index", index },
+                                         { "engine_return", returned },
+                                         { "reason", reason },
+                                         { "game_effect", "unknown" } };
+        callback(AsstMsg::SubTaskExtraInfo, info);
+        if (!returned) {
+            invalidate_locked();
+            return false;
+        }
+    }
+    return true;
+}
+
+json::value asst::TacticalBattleTask::context_snapshot_locked() const
+{
+    json::array deployed;
+    for (const auto& [oper, location] : m_battlefield_opers) {
+        deployed.emplace_back(
+            json::object { { "name", oper.name },
+                           { "role", static_cast<int>(oper.role) },
+                           { "location", json::array { location.x, location.y } },
+                           { "source", "engine_context" },
+                           { "game_effect", "unknown" } });
+    }
+    json::array skill_usage;
+    for (const auto& [oper, usage] : m_skill_usage) {
+        auto times = m_skill_times.find(oper);
+        skill_usage.emplace_back(
+            json::object { { "name", oper.name },
+                           { "role", static_cast<int>(oper.role) },
+                           { "usage", static_cast<int>(usage) },
+                           { "remaining_times", times == m_skill_times.end() ? -1 : times->second } });
+    }
+    int elapsed = -1;
+    if (m_stopwatch_enabled) {
+        elapsed = static_cast<int>(std::chrono::duration_cast<std::chrono::milliseconds>(
+                                       std::chrono::steady_clock::now() - m_stopwatch_start_time)
+                                       .count());
+    }
+    return json::object {
+        { "schema_version", "1.0" },
+        { "features", json::array { "persistent_context", "passive_observer", "named_actions", "absolute_speed" } },
+        { "ok", true },
+        { "abi_version", 1 },
+        { "context_revision", m_revision.load() },
+        { "context_valid", m_context_valid },
+        { "stage_name", m_stage_name },
+        { "action_sequence", m_action_sequence },
+        { "deployed_operators", std::move(deployed) },
+        { "skill_usage", std::move(skill_usage) },
+        { "camera_shift", json::array { m_camera_shift.first, m_camera_shift.second } },
+        { "camera_count", m_camera_count },
+        { "stopwatch_enabled", m_stopwatch_enabled },
+        { "elapsed_time_ms", elapsed },
+        { "automatic_ready_actions_enabled", false }
+    };
+}
+
+json::value asst::TacticalBattleTask::context_snapshot() const
+{
+    std::unique_lock lock(m_context_mutex, std::try_to_lock);
+    if (!lock.owns_lock()) {
+        return json::object { { "ok", false }, { "error", "BUSY" } };
+    }
+    return context_snapshot_locked();
+}
+
+json::value asst::TacticalBattleTask::observe(const unsigned char* png, size_t size)
+{
+    std::unique_lock lock(m_context_mutex, std::try_to_lock);
+    if (!lock.owns_lock()) {
+        return json::object { { "ok", false }, { "error", "BUSY" } };
+    }
+    if (!png || size == 0 || size > 8 * 1024 * 1024) {
+        return json::object { { "ok", false }, { "error", "INVALID_IMAGE" } };
+    }
+    cv::Mat image = cv::imdecode(std::vector<unsigned char>(png, png + size), cv::IMREAD_COLOR);
+    if (image.empty() || image.cols != WindowWidthDefault || image.rows != WindowHeightDefault) {
+        return json::object { { "ok", false }, { "error", "UNSUPPORTED_IMAGE_GEOMETRY" } };
+    }
+    auto output = context_snapshot_locked();
+    auto previous = std::chrono::steady_clock::now();
+    const auto elapsed = [&previous]() {
+        const auto now = std::chrono::steady_clock::now();
+        const auto duration = std::chrono::duration<double, std::milli>(now - previous).count();
+        previous = now;
+        return duration;
+    };
+    output["vision"] = json::object { { "cost", nullptr },         { "kills", nullptr },
+                                      { "total_kills", nullptr },  { "deployment", nullptr },
+                                      { "skill_states", nullptr }, { "confidence", nullptr },
+                                      { "calibrated", false },     { "input_issued", false },
+                                      { "battle_speed", nullptr }, { "latency_ms", json::object {} } };
+    BattlefieldMatcher flag(image);
+    const bool in_battle = flag.analyze().has_value();
+    output["vision"]["latency_ms"]["battle_hud"] = elapsed();
+    if (!in_battle) {
+        output["vision"]["battle_hud"] = false;
+        return output;
+    }
+    output["vision"]["battle_hud"] = true;
+    BattlefieldMatcher cost(image);
+    cost.set_object_of_interest({ .flag = false, .costs = true });
+    if (const auto result = cost.analyze()) {
+        output["vision"]["cost"] = result->costs.value;
+    }
+    BattlefieldMatcher kills(image);
+    output["vision"]["latency_ms"]["cost"] = elapsed();
+    kills.set_object_of_interest({ .flag = false, .kills = true });
+    if (const auto result = kills.analyze()) {
+        output["vision"]["kills"] = result->kills.value.first;
+        output["vision"]["total_kills"] = result->kills.value.second;
+    }
+    BattlefieldMatcher deployment(image);
+    output["vision"]["latency_ms"]["kills"] = elapsed();
+    RegionOCRer speed(image, Rect { 1060, 16, 80, 44 });
+    speed.set_bin_threshold(190);
+    speed.set_bin_expansion(1);
+    if (const auto result = speed.analyze()) {
+        output["vision"]["speed_text"] = result->text;
+        output["vision"]["speed_score"] = result->score;
+        if (result->score >= 0.98) {
+            if (result->text == "1X" || result->text == "1x" || result->text == "1×") {
+                output["vision"]["battle_speed"] = 1;
+            }
+            else if (result->text == "2X" || result->text == "2x" || result->text == "2×") {
+                output["vision"]["battle_speed"] = 2;
+            }
+        }
+    }
+    output["vision"]["latency_ms"]["battle_speed"] = elapsed();
+    deployment.set_object_of_interest({ .flag = false, .deployment = true, .oper_cost = true });
+    if (auto result = deployment.analyze()) {
+        identify_deployment_passive(result->deployment);
+        json::array operators;
+        for (const auto& oper : result->deployment) {
+            operators.emplace_back(
+                json::object { { "index", oper.index },
+                               { "candidate_name", oper.name },
+                               { "role", static_cast<int>(oper.role) },
+                               { "cost", oper.cost },
+                               { "available", oper.available },
+                               { "cooling", oper.cooling },
+                               { "rect", json::array { oper.rect.x, oper.rect.y, oper.rect.width, oper.rect.height } },
+                               { "confidence", nullptr } });
+        }
+        output["vision"]["deployment"] = std::move(operators);
+    }
+    if (m_context_valid) {
+        output["vision"]["latency_ms"]["deployment"] = elapsed();
+        json::array skills;
+        for (const auto& [oper, location] : m_battlefield_opers) {
+            const auto tile = m_normal_tile_info.find(location);
+            if (tile == m_normal_tile_info.end()) {
+                continue;
+            }
+            BattlefieldClassifier classifier(image);
+            classifier.set_base_point(tile->second.pos);
+            classifier.set_object_of_interest({ .skill_ready = true });
+            if (const auto result = classifier.analyze()) {
+                json::array probabilities;
+                for (const auto value : result->skill_ready.prob) {
+                    probabilities.emplace_back(value);
+                }
+                skills.emplace_back(
+                    json::object { { "name", oper.name },
+                                   { "location", json::array { location.x, location.y } },
+                                   { "candidate_ready", result->skill_ready.ready },
+                                   { "score", result->skill_ready.score },
+                                   { "probabilities", std::move(probabilities) },
+                                   { "confidence", nullptr },
+                                   { "status", "experimental" },
+                                   { "preprocessing", "upstream_BattlefieldClassifier" } });
+            }
+        }
+        output["vision"]["skill_states"] = std::move(skills);
+    }
+    output["vision"]["latency_ms"]["skill_states"] = elapsed();
+    return output;
+}
