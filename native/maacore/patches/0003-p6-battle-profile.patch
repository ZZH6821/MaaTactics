     std::unique_lock<std::mutex> lock(m_entry_mutex);
     LogTraceFunction;
+
+#ifdef MAATACTICS_BATTLE_ONLY
+    // The battle profile is immutable in a worker. Open a new worker to change it.
+    if (!m_battle_path.empty()) {
+        return m_loaded && path == m_battle_path;
+    }
+    const auto profile = json::open(path / "maatactics-profile.json"_p);
+    if (!profile || profile->get("profile", "") != "battle-v1" || profile->get("schema_version", 0) != 1) {
+        LogError << "Battle resource profile is missing or unsupported" << path;
+        return false;
+    }
+    // A loader can fail after filling a singleton. Only a fresh process may try again.
+    m_battle_path = path;
+    ResDir.set(path);
+    const auto required = [&]<typename T>(const std::filesystem::path& relative) {
+        const auto file = path / relative;
+        if (!std::filesystem::exists(file) || !SingletonHolder<T>::get_instance().load(file)) {
+            LogError << "Battle resource failed to load" << file;
+            return false;
+        }
+        return true;
+    };
+    if (!required.template operator()<GeneralConfig>("config.json"_p) ||
+        !required.template operator()<BattleDataConfig>("battle_data.json"_p) ||
+        !required.template operator()<OcrConfig>("ocr_config.json"_p) ||
+        !required.template operator()<TilePack>("Arknights-Tile-Pos/overview.json"_p) ||
+        !required.template operator()<OnnxSessions>("onnx/skill_ready_cls.onnx"_p) ||
+        !required.template operator()<WordOcr>("PaddleOCR"_p) ||
+        !required.template operator()<CharOcr>("PaddleCharOCR"_p) ||
+        !required.template operator()<TaskData>("tasks"_p)) {
+        return false;
+    }
+    auto& templates = TemplResource::get_instance();
+    templates.set_load_required(Task.get_templ_required());
+    if (!required.template operator()<TemplResource>("template"_p)) {
+        return false;
+    }
+    const auto avatars = UserDir.get() / "cache/avatars"_p;
+    std::filesystem::create_directories(avatars);
+    AvatarCacheManager::get_instance().load(avatars);
