+        if(source MATCHES "/Task/(Interface|Miscellaneous)/([^/]+)[.]cpp$")
+            set(group "${CMAKE_MATCH_1}")
+            set(name "${CMAKE_MATCH_2}")
+            if((group STREQUAL "Interface" AND NOT name IN_LIST battle_interfaces)
+               OR (group STREQUAL "Miscellaneous" AND NOT name IN_LIST battle_misc))
+                list(REMOVE_ITEM maa_src "${source}")
+            endif()
+        endif()
+    endforeach()
+endif()
+
