+void asst::BattleHelper::identify_deployment_passive(std::vector<battle::DeploymentOper>& opers) const
+{
+    for (auto& oper : opers) {
+        std::vector<std::pair<std::string, cv::Mat>> avatars;
+        for (const auto& cached : m_cur_deployment_opers) {
+            if (cached.role == oper.role && !cached.name.empty() && !cached.avatar.empty()) {
+                avatars.emplace_back(cached.name, cached.avatar);
+            }
+        }
+        if (!avatars.empty()) {
+            if (const auto match = analyze_oper_with_cache(oper, avatars)) {
+                oper.name = match->templ_info.name;
+            }
+        }
+    }
